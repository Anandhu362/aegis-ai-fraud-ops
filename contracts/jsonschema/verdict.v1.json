{
  "$defs": {
    "ActuatorAction": {
      "description": "Actions executed or requested by the deterministic PolicyAgent.",
      "properties": {
        "account_locked": {
          "default": false,
          "description": "Core banking account lockout status",
          "title": "Account Locked",
          "type": "boolean"
        },
        "tx_blocked": {
          "default": false,
          "description": "Transaction blocked status",
          "title": "Tx Blocked",
          "type": "boolean"
        },
        "alert_dispatched": {
          "default": false,
          "description": "Customer alert dispatched",
          "title": "Alert Dispatched",
          "type": "boolean"
        },
        "dispatch_channel": {
          "default": "LOG_ONLY",
          "description": "Channel used for security alert",
          "title": "Dispatch Channel",
          "type": "string"
        },
        "early_containment": {
          "default": false,
          "description": "True if lockout occurred before orchestrator verdict via early containment",
          "title": "Early Containment",
          "type": "boolean"
        }
      },
      "title": "ActuatorAction",
      "type": "object"
    },
    "AnalystDecision": {
      "description": "Manual review decision recorded by a human fraud analyst.",
      "properties": {
        "action": {
          "description": "APPROVE | CONFIRM_FRAUD | UNLOCK",
          "title": "Action",
          "type": "string"
        },
        "reason": {
          "description": "Analyst rationale",
          "title": "Reason",
          "type": "string"
        },
        "analyst_uid": {
          "description": "Analyst user identifier",
          "title": "Analyst Uid",
          "type": "string"
        },
        "at": {
          "description": "Timestamp of action in epoch milliseconds",
          "title": "At",
          "type": "integer"
        }
      },
      "required": [
        "action",
        "reason",
        "analyst_uid",
        "at"
      ],
      "title": "AnalystDecision",
      "type": "object"
    },
    "CaseNarrative": {
      "description": "Asynchronous deep review narrative generated by Gemini Pro.",
      "properties": {
        "executive_summary": {
          "description": "High-level narrative of the fraud event",
          "title": "Executive Summary",
          "type": "string"
        },
        "chronology": {
          "description": "Reconstructed event timeline",
          "items": {
            "type": "string"
          },
          "title": "Chronology",
          "type": "array"
        },
        "recommended_action": {
          "description": "Analyst recommendation",
          "title": "Recommended Action",
          "type": "string"
        },
        "confidence_score": {
          "description": "Agent confidence in review",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        }
      },
      "required": [
        "executive_summary",
        "recommended_action",
        "confidence_score"
      ],
      "title": "CaseNarrative",
      "type": "object"
    },
    "Decision": {
      "description": "Final automated fraud policy decision.",
      "enum": [
        "ALLOW",
        "REVIEW",
        "BLOCK_TX",
        "LOCK_ACCOUNT",
        "DECLINE_LOCKED"
      ],
      "title": "Decision",
      "type": "string"
    },
    "InvestigationStatus": {
      "description": "Lifecycle status of a fraud investigation.",
      "enum": [
        "QUEUED",
        "PROCESSING",
        "COMPLETED",
        "ACTION_TAKEN",
        "FAILED"
      ],
      "title": "InvestigationStatus",
      "type": "string"
    },
    "LatencyBreakdown": {
      "description": "Millisecond latency metrics across pipeline stages.",
      "properties": {
        "total": {
          "default": 0,
          "description": "Total pipeline latency in ms",
          "title": "Total",
          "type": "integer"
        },
        "enrichment": {
          "default": 0,
          "description": "Deterministic enrichment latency in ms",
          "title": "Enrichment",
          "type": "integer"
        },
        "specialists": {
          "default": 0,
          "description": "Parallel specialists latency in ms",
          "title": "Specialists",
          "type": "integer"
        },
        "orchestrator": {
          "default": 0,
          "description": "Orchestrator synthesis latency in ms",
          "title": "Orchestrator",
          "type": "integer"
        },
        "policy": {
          "default": 0,
          "description": "Policy execution and actuation latency in ms",
          "title": "Policy",
          "type": "integer"
        }
      },
      "title": "LatencyBreakdown",
      "type": "object"
    },
    "ModelVersions": {
      "description": "Version tracking of active prompts and risk policies.",
      "properties": {
        "policy": {
          "default": "1.0.0",
          "description": "risk_policy.yaml semantic version",
          "title": "Policy",
          "type": "string"
        },
        "orchestrator": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Orchestrator model & prompt version",
          "title": "Orchestrator",
          "type": "object"
        },
        "specialist": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Specialist model & prompt version",
          "title": "Specialist",
          "type": "object"
        }
      },
      "title": "ModelVersions",
      "type": "object"
    },
    "RiskLevel": {
      "description": "Categorical risk assessment.",
      "enum": [
        "LOW",
        "ELEVATED",
        "HIGH",
        "CRITICAL"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "ScoreBreakdown": {
      "description": "Detailed trace of deterministic base score, hard floors, and LLM adjustment.",
      "properties": {
        "base": {
          "description": "Deterministic base score from weighted signals",
          "maximum": 100,
          "minimum": 0,
          "title": "Base",
          "type": "integer"
        },
        "floor": {
          "description": "Highest triggered hard-rule risk floor",
          "maximum": 100,
          "minimum": 0,
          "title": "Floor",
          "type": "integer"
        },
        "llm_adjustment": {
          "description": "Bounded orchestrator adjustment [-10, +10]",
          "maximum": 10,
          "minimum": -10,
          "title": "Llm Adjustment",
          "type": "integer"
        },
        "signals": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Points awarded per signal ID",
          "title": "Signals",
          "type": "object"
        },
        "rules": {
          "description": "IDs of hard rules triggered (e.g. H1)",
          "items": {
            "type": "string"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "base",
        "floor",
        "llm_adjustment"
      ],
      "title": "ScoreBreakdown",
      "type": "object"
    },
    "Typology": {
      "description": "Identified fraud typology or pattern.",
      "enum": [
        "NONE",
        "ACCOUNT_TAKEOVER",
        "STRUCTURING",
        "CREDENTIAL_STUFFING",
        "CARD_TESTING",
        "MERCHANT_DEVIATION",
        "OTHER"
      ],
      "title": "Typology",
      "type": "string"
    }
  },
  "description": "Final, explainable investigation verdict and risk assessment.",
  "properties": {
    "tx_id": {
      "description": "Transaction identifier",
      "title": "Tx Id",
      "type": "string"
    },
    "user_id": {
      "description": "Customer identifier",
      "title": "User Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/InvestigationStatus",
      "default": "COMPLETED",
      "description": "Investigation lifecycle state"
    },
    "threat_score": {
      "description": "Final 0-100 composite threat score",
      "maximum": 100,
      "minimum": 0,
      "title": "Threat Score",
      "type": "integer"
    },
    "risk_level": {
      "$ref": "#/$defs/RiskLevel",
      "description": "Categorical risk band"
    },
    "decision": {
      "$ref": "#/$defs/Decision",
      "description": "Automated policy decision"
    },
    "should_actuate": {
      "default": false,
      "description": "True if automated containment was required",
      "title": "Should Actuate",
      "type": "boolean"
    },
    "typology": {
      "$ref": "#/$defs/Typology",
      "default": "NONE",
      "description": "Classified fraud pattern"
    },
    "rationale": {
      "description": "Evidence-backed human readable explanation",
      "title": "Rationale",
      "type": "string"
    },
    "cited_evidence": {
      "description": "Pointers to validated signals used in decision",
      "items": {
        "type": "string"
      },
      "title": "Cited Evidence",
      "type": "array"
    },
    "score_breakdown": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScoreBreakdown"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Detailed score decomposition"
    },
    "actuator_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActuatorAction"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Actions executed by actuator"
    },
    "features_snapshot": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Sanitized feature snapshot",
      "title": "Features Snapshot"
    },
    "deep_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaseNarrative"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Asynchronous deep review"
    },
    "analyst_decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalystDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Human analyst override"
    },
    "degraded": {
      "default": false,
      "description": "True if fallback path was used due to model failure",
      "title": "Degraded",
      "type": "boolean"
    },
    "versions": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelVersions"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Model and policy version metadata"
    },
    "latency_ms": {
      "$ref": "#/$defs/LatencyBreakdown",
      "description": "Latency breakdown"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Pipeline start timestamp (epoch ms)",
      "title": "Started At"
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Pipeline completion timestamp (epoch ms)",
      "title": "Completed At"
    }
  },
  "required": [
    "tx_id",
    "user_id",
    "threat_score",
    "risk_level",
    "decision",
    "rationale"
  ],
  "title": "Verdict",
  "type": "object"
}
