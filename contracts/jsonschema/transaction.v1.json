{
  "$defs": {
    "Channel": {
      "description": "Payment transaction channel.",
      "enum": [
        "CARD_PRESENT",
        "ECOMMERCE",
        "TRANSFER",
        "ATM"
      ],
      "title": "Channel",
      "type": "string"
    },
    "Location": {
      "additionalProperties": false,
      "description": "Geographic coordinate and administrative location.",
      "properties": {
        "latitude": {
          "description": "Latitude in decimal degrees [-90, 90]",
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "description": "Longitude in decimal degrees [-180, 180]",
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "Longitude",
          "type": "number"
        },
        "city": {
          "description": "City name",
          "maxLength": 80,
          "minLength": 1,
          "title": "City",
          "type": "string"
        },
        "country": {
          "description": "ISO-3166-1 alpha-2 country code",
          "pattern": "^[A-Z]{2}$",
          "title": "Country",
          "type": "string"
        }
      },
      "required": [
        "latitude",
        "longitude",
        "city",
        "country"
      ],
      "title": "Location",
      "type": "object"
    },
    "MerchantCategory": {
      "description": "Standardized merchant category classification.",
      "enum": [
        "coffee_shop",
        "grocery",
        "restaurant",
        "fuel",
        "retail",
        "electronics",
        "travel",
        "utilities",
        "pharmacy",
        "entertainment",
        "cryptocurrency_brokerage",
        "gambling",
        "money_transfer",
        "gift_cards",
        "wire_transfer"
      ],
      "title": "MerchantCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Incoming payment transaction payload.",
  "properties": {
    "tx_id": {
      "description": "Unique transaction ID",
      "pattern": "^TX_[A-Z0-9]{4,32}$",
      "title": "Tx Id",
      "type": "string"
    },
    "user_id": {
      "description": "Customer/account ID",
      "pattern": "^USR_[A-Z0-9]{2,32}$",
      "title": "User Id",
      "type": "string"
    },
    "timestamp": {
      "description": "RFC 3339 UTC timestamp",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "amount": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 1000000.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "description": "Monetary value (>0, <=1M, 2dp)",
      "title": "Amount"
    },
    "currency": {
      "description": "ISO-4217 3-letter currency code",
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "merchant": {
      "description": "Untrusted merchant name",
      "maxLength": 120,
      "minLength": 1,
      "title": "Merchant",
      "type": "string"
    },
    "merchant_category": {
      "$ref": "#/$defs/MerchantCategory",
      "description": "Categorical merchant classification"
    },
    "channel": {
      "$ref": "#/$defs/Channel",
      "default": "ECOMMERCE",
      "description": "Transaction channel"
    },
    "device_id": {
      "description": "Client device hardware/browser hash",
      "maxLength": 64,
      "minLength": 1,
      "title": "Device Id",
      "type": "string"
    },
    "ip_address": {
      "anyOf": [
        {
          "format": "ipvanyaddress",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Client IPv4 or IPv6 address",
      "title": "Ip Address"
    },
    "location": {
      "$ref": "#/$defs/Location",
      "description": "Transaction origin geolocation"
    }
  },
  "required": [
    "tx_id",
    "user_id",
    "timestamp",
    "amount",
    "currency",
    "merchant",
    "merchant_category",
    "device_id",
    "location"
  ],
  "title": "Transaction",
  "type": "object"
}
