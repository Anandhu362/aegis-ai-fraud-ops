# ==============================================================================
# Aegis AI Fraud Ops - Environment Configuration Template
# Copy this file to .env and configure for your local/dev/demo environment.
# ==============================================================================

# Core GCP Settings
GCP_PROJECT=aegis-fraud-ops-dev
AEGIS_ENV=local                             # local | dev | demo
AEGIS_ADAPTER_MODE=mock                     # mock (offline) | gcp (real Vertex, Firestore, BigQuery)
AEGIS_LOG_LEVEL=INFO

# Vertex AI & Gemini Model Configuration
# Note: Always verify model availability using `task ai:models`
GEMINI_API_KEY=                             # Google AI Studio API key (optional if using GCP ADC)
GOOGLE_MAPS_API_KEY=                        # Google Maps Platform API key (optional for geo lookups)
AEGIS_VERTEX_LOCATION=global                # global or us-central1
AEGIS_MODEL_ORCHESTRATOR=gemini-2.5-flash     # Primary synthesis model (Flash tier)
AEGIS_MODEL_ORCHESTRATOR_FALLBACK=gemini-flash-latest
AEGIS_MODEL_SPECIALIST=gemini-flash-lite-latest  # Specialists (Behavioral, Threat Intel)
AEGIS_MODEL_SPECIALIST_FALLBACK=gemini-3.1-flash-lite-preview
AEGIS_MODEL_DEEP_REVIEW=gemini-pro-latest      # Out-of-band deep review narrative

# Gateway & Pipeline Transport
AEGIS_ANALYZE_MODE=async                    # async (Pub/Sub) | sync (Direct HTTP for evals/local)
AEGIS_PUBSUB_TOPIC=tx-ingest
AEGIS_ENGINE_URL=http://localhost:8090
AEGIS_ACTUATOR_URL=http://localhost:8070
AEGIS_RATE_LIMIT_RPS=20
AEGIS_API_KEYS_SECRET=aegis-api-keys

# Risk Policy & Timeouts
AEGIS_RISK_POLICY_PATH=config/risk_policy.yaml
AEGIS_TIMEOUT_PIPELINE_MS=6000              # Global hard cap
AEGIS_TIMEOUT_LLM_MS=1500                   # Per LLM call timeout
AEGIS_BQ_DATASET=fraud_telemetry

# Actuator & Notifications
AEGIS_NOTIFIER=log                          # log | whatsapp

# Local Emulators (set automatically in `task dev`)
# FIRESTORE_EMULATOR_HOST=localhost:8081
# PUBSUB_EMULATOR_HOST=localhost:8085

# Frontend (Vite) Environment Variables
VITE_AEGIS_ENV=local
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=aegis-fraud-ops-dev
VITE_FIREBASE_API_KEY=mock-api-key-for-local
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_GOOGLE_MAPS_API_KEY=                   # Google Maps JavaScript API key for SOC dashboard
