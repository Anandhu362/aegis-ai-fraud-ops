rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Investigations collection and sub-collections (events, etc)
    match /investigations/{tx_id} {
      allow read: if request.auth != null;
      allow write: if false; // All writes are server-side via backend engine

      match /events/{seq} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // System metrics & eval reports (read-only for dashboard)
    match /system/{metricDoc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny all direct client access to sensitive internal collections
    match /user_profiles/{userId} {
      allow read, write: if false;
    }

    match /accounts/{userId} {
      allow read, write: if false;
    }

    match /intel/{doc} {
      allow read, write: if false;
    }
  }
}
